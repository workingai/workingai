{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/ssg/ws01_index(?:\\.html)?",
      "headers": {
        "Location": "/ssg"
      },
      "status": 308
    },
    {
      "src": "/ssg/pdfviewer(?:\\.html)?",
      "headers": {
        "Location": "/ssg/download/mkt_2610.pdf"
      },
      "status": 308
    },
    {
      "src": "/shinsegae/?",
      "headers": {
        "Location": "/ssg"
      },
      "status": 308
    },
    {
      "src": "/shinsegae/(.*)",
      "headers": {
        "Location": "/ssg/$1"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}